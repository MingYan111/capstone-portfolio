# ===== Client environment variables (copy this file to .env and fill in real values) =====

# Base URL of the deployed back-end API.
# In development the Vite proxy (see vite.config.js) forwards /api to http://localhost:5000,
# so you can leave this unset locally. For the deployed build, set it to your Render URL:
# VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=
