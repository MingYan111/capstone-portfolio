# ===== Server environment variables (copy this file to .env and fill in real values) =====

# Port the API listens on
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<YOUR_MONGODB_USERNAME>:<YOUR_MONGODB_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Admin account created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# Comma-separated list of allowed CORS origins (the deployed front-end URL)
# Example: https://your-portfolio.vercel.app
CLIENT_URL=http://localhost:5173
